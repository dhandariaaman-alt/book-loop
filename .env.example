# Copy this file to .env and fill in the values.

# PostgreSQL connection string (e.g. from https://neon.tech)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret for signing sessions. Generate one with:  npx auth secret
AUTH_SECRET=""

# Google sign-in (optional). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public URL of the app (used in password reset links)
APP_URL="http://localhost:3000"
