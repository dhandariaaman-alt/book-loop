# Copy this file to .env and fill in the values.

# Supabase database (Project → Connect → ORMs → Prisma).
# Replace [YOUR-PASSWORD] with your database password.
# Pooled connection, used by the app:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used to create/update tables:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Random secret for signing sessions. Generate one with:  npx auth secret
AUTH_SECRET=""

# Google sign-in (optional). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public URL of the app (used in password reset links)
APP_URL="http://localhost:3000"
