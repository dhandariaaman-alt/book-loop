# Copy this file to .env and fill in the values.

# Supabase database (Project → Connect → ORMs → Prisma).
# Replace [YOUR-PASSWORD] with your database password.
# Pooled connection, used by the app:
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection, used to create/update tables:
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Random secret for signing sessions. Generate one with:  npx auth secret
AUTH_SECRET=""

# Google sign-in (optional). Create OAuth credentials at
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Public URL of the app (used in password reset links)
APP_URL="http://localhost:3000"

# Book photo storage (optional in development; required before deploying).
# Without these, photos are saved to public/uploads on this machine.
# Supabase → Project Settings → API. Create a PUBLIC storage bucket named book-images.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="book-images"

# Secret for scheduled jobs (reservation expiry, reminders, notification retries).
# Call e.g. GET /api/cron/expire-reservations with header  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
# Retry failed email/push/SMS notifications every few minutes:
#   GET /api/cron/notifications  with header  Authorization: Bearer <CRON_SECRET>

# Browser push notifications (optional). Generate a key pair once with:
#   npx web-push generate-vapid-keys
# Without these, the "Enable browser notifications" button explains push isn't set up.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, a mailto: or https: URL
VAPID_SUBJECT="mailto:hello@example.com"

# SMS notifications through Twilio (optional; SMS is opt-in per user and may cost money).
# Twilio Console -> Account Info. TWILIO_FROM is your Twilio number in E.164 (e.g. +15005550006)
# or a Messaging Service SID (starts with MG).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
